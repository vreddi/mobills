{
  "name": "@mobills/convex",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/convex/convex",
  "targets": {
    "codegen": {
      "executor": "nx:run-commands",
      "options": {
        "command": "convex codegen",
        "cwd": "packages/convex"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.json",
        "cwd": "packages/convex"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p tsconfig.json",
        "cwd": "packages/convex"
      }
    }
  }
}
