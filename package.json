{
  "name": "mobills",
  "version": "0.0.0",
  "private": true,
  "description": "Manage a shared T-Mobile bill split across a group of friends.",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "nx run-many -t build",
    "typecheck": "nx run-many -t typecheck",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "cli:build": "pnpm --filter @mobills/cli build",
    "cli:link": "pnpm cli:build && node tools/cli/scripts/global-link.mjs link",
    "cli:unlink": "node tools/cli/scripts/global-link.mjs unlink",
    "convex:dev": "pnpm --filter @mobills/convex run dev",
    "convex:deploy": "pnpm --filter @mobills/convex run deploy",
    "nx": "nx",
    "plan": "nx release plan",
    "plan:check": "nx release plan:check",
    "release": "nx release",
    "release:publish": "nx release publish"
  },
  "devDependencies": {
    "@nx/js": "latest",
    "nx": "latest",
    "typescript": "^5.6.3"
  }
}
