# Convex — deployment URL (from `npx convex dev`) and optional deploy key.
CONVEX_URL=
# Optional: used by `convex deploy` in CI/non-interactive environments.
CONVEX_DEPLOY_KEY=

# Clerk — application keys.
# CLERK_PUBLISHABLE_KEY is required for `mobills login` (hotloads Clerk.js in
# the browser to sign you in).
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk issuer / Frontend API URL. Must match the `convex` JWT template issuer.
# Used by Convex (auth.config.ts) to validate Clerk-issued JWTs.
CLERK_JWT_ISSUER_DOMAIN=
# Optional / legacy: a Clerk session token minted from the JWT template named
# exactly `convex`. Prefer `mobills login`, which caches a token for you. This
# is only used as a fallback when no cached login credential exists.
CLERK_SESSION_TOKEN=

# Splitwise — legacy/fallback personal API key (create one under "Your apps"
# at https://secure.splitwise.com/apps). Prefer `mobills integration splitwise
# setup`, which stores the key in ~/.config/mobills/integrations.json (mode 0600)
# so it works from any directory. This env var is only used as a fallback.
SPLITWISE_API_KEY=
# Optional: override the Splitwise API base URL (defaults to the v3.0 endpoint).
SPLITWISE_API_BASE_URL=
