# Convex — deployment URL (from `npx convex dev`) and optional deploy key.
CONVEX_URL=
# Optional: used by `convex deploy` in CI/non-interactive environments.
CONVEX_DEPLOY_KEY=

# Clerk — application keys.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk issuer / Frontend API URL. Must match the `convex` JWT template issuer.
# Used by Convex (auth.config.ts) to validate Clerk-issued JWTs.
CLERK_JWT_ISSUER_DOMAIN=
# A Clerk session token minted from the JWT template named exactly `convex`.
# The CLI sends this to Convex so it can identify the authenticated operator.
CLERK_SESSION_TOKEN=

# Splitwise — personal API key (Bearer token) created under "Your apps" at
# https://secure.splitwise.com/apps. Used by @mobills/splitwise to post expenses.
SPLITWISE_API_KEY=
# Optional: override the Splitwise API base URL (defaults to the v3.0 endpoint).
SPLITWISE_API_BASE_URL=
